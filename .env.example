# Google Maps review link (get from your Google Business Profile)
VITE_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID

# WhatsApp community invite link
VITE_COMMUNITY_URL=https://chat.whatsapp.com/YOUR_INVITE_CODE

# Gemini or OpenAI API key for review ghostwriter
LLM_API_KEY=your_llm_api_key_here

# PostgreSQL connection string (optional — SQLite used if absent)
DATABASE_URL=postgresql://user:password@localhost:5432/staycircle

# Server port
PORT=3001

# Admin dashboard password (optional, leave blank to disable auth)
ADMIN_PASSWORD=
